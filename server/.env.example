# Copy this file to .env and fill in real values. .env is git-ignored.

# API
PORT=4000

# Database container (docker-compose.yml)
POSTGRES_USER=bank
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bank
POSTGRES_PORT=5433

# Prisma connection string – must match the values above
DATABASE_URL=postgresql://bank:change-me@localhost:5433/bank

# Ta'im (optional): when the business day closes by itself if nobody closed
# it by hand, on the restaurant's clock
TAIM_DAY_ENDS_AT=04:00
TAIM_TIME_ZONE=Asia/Jerusalem
# Minutes after a table's last dish was served before the Chef can fire its
# held dishes from the kitchen (the waiter can fire any time)
TAIM_KITCHEN_FIRE_AFTER=10
