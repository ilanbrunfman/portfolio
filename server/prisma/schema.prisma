// Bank tracker database schema.
// Change a model → run `npm run db:migrate` → Prisma writes a SQL migration
// in prisma/migrations and regenerates the client.
//
// Money is stored as whole cents (Int): 1250 = 12.50. One currency for the app.
// Balances are never stored – they're computed from openingBalance + transactions.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT
  CASH
}

enum CategoryKind {
  INCOME
  EXPENSE
}

model Account {
  id             Int           @id @default(autoincrement())
  name           String
  type           AccountType   @default(CHECKING)
  openingBalance Int           @default(0) // cents
  color          String? // e.g. "#aa3bff" for the account card
  archived       Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  transactions   Transaction[]

  @@map("accounts")
}

model Category {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  kind         CategoryKind
  color        String?
  transactions Transaction[]

  @@map("categories")
}

model Transaction {
  id          Int       @id @default(autoincrement())
  accountId   Int
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date        DateTime  @db.Date // calendar day, no time
  amount      Int // cents: positive = money in, negative = money out
  description String
  categoryId  Int?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  note        String?
  // A transfer is two rows (out of one account, into another) sharing this id
  transferId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([accountId, date])
  @@index([transferId])
  @@map("transactions")
}
