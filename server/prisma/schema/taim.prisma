// Ta'im (restaurant app) tables, all in the Postgres schema "taim" (taim.staff, …).
// Change a model → run `npm run db:migrate`.
//
// Money will be whole cents (Int), like the bank tracker.

// What a staff member may do is decided by their role (see
// src/projects/taim/roles.js). Owner and Manager are one role.
enum StaffRole {
  MANAGER
  CHEF
  COOK
  HOST
  WAITER

  @@schema("taim")
}

// The people on the "Who are you?" screen. There are no passwords: picking
// a person is the login, and the server checks their role on every request.
model Staff {
  id             Int           @id @default(autoincrement())
  name           String
  role           StaffRole
  createdAt      DateTime      @default(now())
  orders         Order[]
  daysClosed     BusinessDay[]
  dishesFired    OrderItem[]   @relation("DishFiredBy")
  dishesStarted  OrderItem[]   @relation("DishStartedBy")
  dishesServed   OrderItem[]   @relation("DishServedBy")
  menusCreated   MenuVersion[] @relation("VersionCreatedBy")
  menusPublished MenuVersion[] @relation("VersionPublishedBy")
  returns        ItemReturn[]

  @@map("staff")
  @@schema("taim")
}

// Step 3.1: the menu has versions. The ACTIVE one is what everyone uses;
// the Chef edits a DRAFT (a copy of it) and publishes it – now, or on a
// date (SCHEDULED until then); the one it replaces becomes ARCHIVED, with
// the dates it ran. At most one of each of ACTIVE, DRAFT and SCHEDULED
// (partial unique indexes in the migration). Each version owns its own
// categories and dishes, so old bills keep pointing at the dishes they were
// ordered from, and income per version is exact.
enum MenuVersionStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  ARCHIVED

  @@schema("taim")
}

model MenuVersion {
  id            Int               @id @default(autoincrement())
  number        Int               @unique // v1, v2, v3…
  name          String // "Autumn 2026"
  season        String? // Spring, Summer, Autumn, Winter, or anything ("Holidays")
  note          String? // "new grill dishes"
  status        MenuVersionStatus
  basedOnId     Int? // the version this draft was copied from
  basedOn       MenuVersion?      @relation("BasedOn", fields: [basedOnId], references: [id], onDelete: SetNull)
  copies        MenuVersion[]     @relation("BasedOn")
  createdById   Int? // null = the starting menu, made by the migration
  createdBy     Staff?            @relation("VersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime          @default(now())
  publishedById Int?
  publishedBy   Staff?            @relation("VersionPublishedBy", fields: [publishedById], references: [id], onDelete: Restrict)
  publishedAt   DateTime? // when the Chef tapped Publish
  activeFrom    DateTime? // when it became (or becomes, if scheduled) the menu in use
  activeTo      DateTime? // when the next one replaced it
  categories    MenuCategory[]
  items         MenuItem[]

  @@map("menu_versions")
  @@schema("taim")
}

// A section of the menu: Starters, Mains, … shown in `position` order, in
// one menu version. (Named MenuCategory because the bank already has a
// Category model.)
model MenuCategory {
  id        Int         @id @default(autoincrement())
  versionId Int
  version   MenuVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  name      String
  position  Int // 1, 2, 3… menu order
  items     MenuItem[]

  @@unique([versionId, name])
  @@unique([id, versionId]) // lets a dish's (categoryId, versionId) point here: same version guaranteed
  @@map("categories")
  @@schema("taim")
}

// One dish. Dishes are hidden, never deleted (old orders still point to
// them); a hidden dish is "sold out" and doesn't show on the Order screen.
// `position` is the dish's place in its category (1 = top); new dishes go
// to the top and the Chef can drag them into any order.
model MenuItem {
  id          Int          @id @default(autoincrement())
  // Its version (the same as its category's: a composite foreign key)
  versionId   Int
  version     MenuVersion  @relation(fields: [versionId], references: [id], onDelete: Cascade)
  categoryId  Int
  // Restrict: a category with dishes can't be deleted
  category    MenuCategory @relation(fields: [categoryId, versionId], references: [id, versionId], onDelete: Restrict)
  // The same dish across versions (copied into each new draft): change logs
  // and comparisons follow it even when its name or price changes
  dishKey     String       @default(uuid())
  name        String
  description String?
  price       Int // cents: 1400 = 14.00
  prepMinutes Int? // how long the kitchen should take, set by the Chef; null = not set
  position    Int // 1, 2, 3… within the category
  hidden      Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  orderItems  OrderItem[]

  @@unique([versionId, name])
  @@index([categoryId, position])
  @@index([dishKey])
  @@map("menu_items")
  @@schema("taim")
}

// ---------- floor and orders ----------

// A table on the floor. "Taken" isn't stored: a table is taken while it has
// an OPEN order (and the database allows at most one, see the migration).
// Closing the bill sets needsCleaning; it can't be seated again until a
// host or waiter marks it clean. Floor colours: green = ready, yellow =
// needs cleaning, grey = dining. Tables can be combined for a big party:
// see joinedToId.
model DiningTable {
  id            Int           @id @default(autoincrement())
  label         String        @unique // "T1"
  seats         Int
  position      Int // floor order: 1, 2, 3…
  needsCleaning Boolean       @default(false)
  orders        Order[]
  // Combined tables: the others in a group point to the main table (the
  // first on the floor), which takes the group's orders. null = on its own
  // or a main table.
  joinedToId    Int?
  joinedTo      DiningTable?  @relation("CombinedTables", fields: [joinedToId], references: [id], onDelete: SetNull)
  joined        DiningTable[] @relation("CombinedTables")

  @@map("dining_tables")
  @@schema("taim")
}

enum OrderType {
  TABLE
  TAKEOUT

  @@schema("taim")
}

enum OrderStatus {
  OPEN
  CLOSED

  @@schema("taim")
}

// What happens to each dish: NEW (on the bill, not sent to the kitchen
// yet) → the waiter sends it → PREPARING → the kitchen sends it out →
// SENT_OUT (step 5); SENT_OUT → CAME_BACK records a loss (step 6).
// WASTED: food lost without a guest giving it back – cancelled after the
// kitchen started it, dropped on the way, or made wrong and redone.
enum DishStatus {
  NEW
  PREPARING
  SENT_OUT
  CAME_BACK
  WASTED

  @@schema("taim")
}

// One visit to a table, or one take-out. TABLE orders have a table and a
// guest count; TAKEOUT orders have a customer name and phone (to call when
// it's ready) and no table (CHECK rules in the migrations enforce this).
model Order {
  id            Int          @id @default(autoincrement())
  type          OrderType
  tableId       Int?
  table         DiningTable? @relation(fields: [tableId], references: [id], onDelete: Restrict)
  guests        Int?
  customerName  String?
  customerPhone String? // take-out only, optional
  status        OrderStatus  @default(OPEN)
  openedById    Int
  openedBy      Staff        @relation(fields: [openedById], references: [id], onDelete: Restrict)
  openedAt      DateTime     @default(now())
  closedAt      DateTime?
  items         OrderItem[]
  // Set when the Manager or Chef closes the day: the bill then belongs to
  // that day's report and can't change any more. null = today's bills.
  businessDayId Int?
  businessDay   BusinessDay? @relation(fields: [businessDayId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([businessDayId])
  @@map("orders")
  @@schema("taim")
}

// Why a dish was lost. A guest gave it back (a return): COLD … OTHER.
// Waste (no guest gave it back): CANCELLED (after the kitchen started it),
// DROPPED (on the way), MADE_WRONG (in the kitchen, redone).
enum ReturnReason {
  COLD
  WRONG_DISH
  TASTE
  UNDERCOOKED
  ALLERGY // allergy, or something in it
  TOO_SLOW
  OTHER
  CANCELLED
  DROPPED
  MADE_WRONG

  @@schema("taim")
}

// Is a loss a guest's return or waste?
enum LossKind {
  RETURN // the guest gave it back (status CAME_BACK)
  WASTE // lost before or without a guest giving it back (status WASTED)
  FIX // the guest sent it back to be fixed (cook it more, more spice): the same plate, still charged, no money lost

  @@schema("taim")
}

// A lost dish (step 6): a return (it came back) or waste – or a fix (sent
// back to be fixed, no money lost). The reason, an optional note, who
// recorded it and when. A dish can have several (fixed, then given back),
// but at most one return or waste (unique index in the migration). The
// money lost is the dish's price, plus its free remake or replacement's
// for a return; it's calculated from these rows, not stored. The reason
// matches the kind (CHECK in the migration).
model ItemReturn {
  id          Int          @id @default(autoincrement())
  orderItemId Int // a dish can have several: fixed first, then given back
  orderItem   OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  kind        LossKind     @default(RETURN)
  reason      ReturnReason
  note        String? // "lukewarm in the middle", at most 200 characters
  staffId     Int
  staff       Staff        @relation(fields: [staffId], references: [id], onDelete: Restrict)
  createdAt   DateTime     @default(now())

  @@index([createdAt])
  @@index([orderItemId])
  @@map("item_returns")
  @@schema("taim")
}

// A closed business day: the end-of-day report. A day runs from the last
// close to this one (so a night past midnight is still one day). Closing it
// takes every closed bill not in a day yet; it's refused while bills are
// open. The totals are saved as they were at closing (like a printed
// end-of-day report), and the day's bills are locked from then on.
// The Manager or Chef closes it by hand; if nobody did, the server closes it
// at the set time (TAIM_DAY_ENDS_AT, 04:00) with closedById = null.
model BusinessDay {
  id            Int      @id @default(autoincrement())
  openedAt      DateTime // the previous close, or the first bill's opening
  closedAt      DateTime @default(now())
  closedById    Int? // null = closed automatically at the set time (e.g. 04:00)
  closedBy      Staff?   @relation(fields: [closedById], references: [id], onDelete: Restrict)
  orders        Order[]
  billCount     Int // bills closed that day
  tableBills    Int
  takeoutBills  Int
  guests        Int // guests at tables
  sales         Int // cents: the bills' totals (dishes that came back not counted)
  cameBack      Int // dishes that came back
  cameBackValue Int // cents: the dishes that came back plus their free remakes

  @@index([closedAt])
  @@map("business_days")
  @@schema("taim")
}

// One dish on one order (two hummus = two rows, so each is tracked in the
// kitchen on its own). `price` is copied from the menu when the dish is
// added, so later price changes never rewrite an old bill. `seat` says
// which guest gets it (1…guests), or null = shared / take-out.
// `held` = on hold: the waiter sent the order's other dishes first (starters
// now, mains later) and this one waits for "Fire". Only a dish not sent
// yet (NEW) can be held (CHECK in the migration).
model OrderItem {
  id           Int          @id @default(autoincrement())
  orderId      Int
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId   Int
  menuItem     MenuItem     @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  price        Int // cents, copied when ordered
  seat         Int? // guest's seat number at the table; null = shared or take-out
  status       DishStatus // no default: every insert says NEW (or, in the seed, later)
  createdAt    DateTime     @default(now())
  firedAt      DateTime? // when the waiter sent it to the kitchen
  round        Int? // which "Send to kitchen" of this order: 1 = first (e.g. starters), 2 = next…
  held         Boolean      @default(false) // waiting for "Fire" (mains after the starters)
  // Who sent it to the kitchen (null on dishes from before this was kept),
  // and whether the kitchen fired it from "on hold" (Chef or Manager, once
  // the table's earlier dishes were served a while ago)
  firedById    Int?
  firedBy      Staff?       @relation("DishFiredBy", fields: [firedById], references: [id], onDelete: Restrict)
  kitchenFired Boolean      @default(false)
  // Step 5.2: a table's guest takes this dish home – packed, not plated, on
  // the same bill (take-out orders are to go as a whole and leave it false)
  toGo         Boolean      @default(false)
  // Step 5.3: when the kitchen started it (Start on the ticket, or Served
  // straight away) and who; who served it. With firedAt and sentOutAt that
  // is the dish's whole timeline: sent → started → served.
  startedAt    DateTime?
  startedById  Int?
  startedBy    Staff?       @relation("DishStartedBy", fields: [startedById], references: [id], onDelete: Restrict)
  sentOutAt    DateTime?
  servedById   Int?
  servedBy     Staff?       @relation("DishServedBy", fields: [servedById], references: [id], onDelete: Restrict)
  // Step 6: why it came back or was wasted, and the free remake or
  // replacement made for a dish that came back. remakeOfId set = this dish
  // is on the house (the same dish again, or another one instead): not on
  // the bill, and its price counts as a loss with the dish it replaces.
  returns      ItemReturn[] // why it came back, was wasted or sent back to be fixed
  remakeOfId   Int?         @unique
  remakeOf     OrderItem?   @relation("Remake", fields: [remakeOfId], references: [id], onDelete: Restrict)
  remake       OrderItem?   @relation("Remake")

  @@index([orderId])
  @@index([status])
  @@map("order_items")
  @@schema("taim")
}
